generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id             String            @id @default(uuid())
  auth0Id        String            @unique
  name           String
  email          String            @unique
  picture        String?           @db.Text
  roleType       String            @default("FARMER")
  subscriptionTier             String    @default("FREE")
  subscriptionStatus           String?
  stripeCustomerId             String?   @unique
  stripeSubscriptionId         String?   @unique
  subscriptionCurrentPeriodEnd DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  crops          Crop[]            @relation("UserCrops")
  posts          Post[]            @relation("UserPosts")
  rotations      Rotation[]        @relation("UserRotations")
  cropSelections UserCropSelection[] @relation("UserSelections")
  soilTests      SoilTest[]        @relation("UserSoilTests")
  fertilizationPlans FertilizationPlan[] @relation("UserFertilizationPlans")
  harvestRecords HarvestRecord[]   @relation("UserHarvestRecords")
  financialRecords FinancialRecord[] @relation("UserFinancialRecords")
  fields         Field[]           @relation("UserFields")
  farmEvents     FarmEvent[]       @relation("UserFarmEvents")
  inventoryItems InventoryItem[]   @relation("UserInventoryItems")
  inventoryTransactions InventoryTransaction[] @relation("UserInventoryTransactions")
  irrigationEvents IrrigationEvent[] @relation("UserIrrigationEvents")
  equipment        Equipment[]       @relation("UserEquipment")
  maintenanceLogs  EquipmentMaintenanceLog[] @relation("UserMaintenanceLogs")

  @@index([auth0Id])
  @@index([email])
  @@map("users")
}

model Crop {
  id                             Int                @id @default(autoincrement())
  userId                         String
  user                          User               @relation("UserCrops", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cropName                       String
  cropType                       String?
  cropVariety                    String?
  plantingDate                   DateTime?
  harvestingDate                DateTime?
  description                    String?           @db.Text
  imageUrl                       String?           @db.Text
  soilType                       String?
  climate                        String?
  ItShouldNotBeRepeatedForXYears Int?
  nitrogenSupply                 Decimal          @db.Decimal(10,2)
  nitrogenDemand                 Decimal          @db.Decimal(10,2)
  soilResidualNitrogen          Decimal?         @db.Decimal(10,2)
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt
  deleted                       DateTime?
  aiGenerated                   Boolean           @default(false)

  details                      CropDetail[]        @relation("CropDetails")
  rotationPlans               RotationPlan[]      @relation("CropRotationPlans")
  userSelections              UserCropSelection[] @relation("CropSelections")
  fertilizationPlans         FertilizationPlan[] @relation("CropFertilizationPlans")
  harvestRecords              HarvestRecord[]     @relation("CropHarvestRecords")
  financialRecords            FinancialRecord[]   @relation("CropFinancialRecords")

  @@index([userId])
  @@index([cropName])
  @@map("crops")
}

model CropDetail {
  id        Int       @id @default(autoincrement())
  value     String
  detailType String   
  cropId    Int
  crop      Crop      @relation("CropDetails", fields: [cropId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([cropId, detailType])
  @@map("crop_details")
}

model Field {
  id            Int            @id @default(autoincrement())
  userId        String
  user          User           @relation("UserFields", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name          String
  areaHa        Decimal?       @db.Decimal(10,2)
  soilType      String?
  gpsLat        Decimal?       @db.Decimal(10,7)
  gpsLng        Decimal?       @db.Decimal(10,7)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  soilTests      SoilTest[]       @relation("FieldSoilTests")
  harvestRecords HarvestRecord[]  @relation("FieldHarvestRecords")
  rotations      Rotation[]       @relation("FieldRotations")

  @@index([userId])
  @@map("fields")
}

model Rotation {
  id                Int            @id @default(autoincrement())
  userId           String
  user             User           @relation("UserRotations", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fieldId          Int?
  field            Field?         @relation("FieldRotations", fields: [fieldId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rotationName     String
  fieldSize        Decimal        @db.Decimal(10,2)
  numberOfDivisions Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  rotationPlans    RotationPlan[] @relation("RotationPlans")

  @@index([fieldId])
  @@map("rotations")
}

model RotationPlan {
  id              Int       @id @default(autoincrement())
  rotationId      Int
  rotation        Rotation  @relation("RotationPlans", fields: [rotationId], references: [id], onDelete: Cascade)
  year            Int
  division        Int
  cropId          Int
  crop            Crop      @relation("CropRotationPlans", fields: [cropId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plantingDate    DateTime?
  harvestingDate  DateTime?
  divisionSize    Decimal?  @db.Decimal(10,2)
  nitrogenBalance Decimal?  @db.Decimal(10,2)
  directlyUpdated Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  harvestRecords  HarvestRecord[] @relation("RotationPlanHarvestRecords")

  @@map("rotation_plans")
}

model Post {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation("UserPosts", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title       String
  brief       String?  @db.Text
  description String?  @db.Text
  imageUrl    String?  @db.Text
  author      String?
  tags        String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("posts")
}

model UserCropSelection {
  id            Int      @id @default(autoincrement())
  userId        String
  user          User     @relation("UserSelections", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cropId        Int
  crop          Crop     @relation("CropSelections", fields: [cropId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  selectionCount Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  
  @@unique([userId, cropId])
  @@map("user_crop_selections")
}

model SoilTest {
  id              Int       @id @default(autoincrement())
  userId          String
  user            User      @relation("UserSoilTests", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fieldId         Int?
  field           Field?    @relation("FieldSoilTests", fields: [fieldId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  testDate        DateTime
  fieldLocation   String
  pH              Decimal   @db.Decimal(4,2)
  organicMatter   Decimal   @db.Decimal(5,2)
  nitrogen        Decimal   @db.Decimal(10,2)
  phosphorus      Decimal   @db.Decimal(10,2)
  potassium       Decimal   @db.Decimal(10,2)
  texture         String
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, testDate])
  @@index([fieldId])
  @@map("soil_tests")
}

model FertilizationPlan {
  id              Int       @id @default(autoincrement())
  userId          String
  user            User      @relation("UserFertilizationPlans", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cropId          Int
  crop            Crop      @relation("CropFertilizationPlans", fields: [cropId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plannedDate     DateTime
  fertilizer      String
  applicationRate Decimal   @db.Decimal(10,2)
  nitrogenContent Decimal   @db.Decimal(5,2)
  applicationMethod String
  notes           String?   @db.Text
  completed       Boolean   @default(false)
  completedDate   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, plannedDate])
  @@index([cropId])
  @@map("fertilization_plans")
}

model AiLookupLog {
  id           Int      @id @default(autoincrement())
  userId       String
  feature      String   @default("CROP_LOOKUP")
  query        String
  outcome      String
  cropId       Int?
  responseJson String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([userId, feature, createdAt])
  @@index([feature, createdAt])
  @@map("ai_lookup_logs")
}

model HarvestRecord {
  id             Int           @id @default(autoincrement())
  userId         String
  user           User          @relation("UserHarvestRecords", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cropId         Int
  crop           Crop          @relation("CropHarvestRecords", fields: [cropId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rotationPlanId Int?
  rotationPlan   RotationPlan? @relation("RotationPlanHarvestRecords", fields: [rotationPlanId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  fieldId        Int?
  field          Field?        @relation("FieldHarvestRecords", fields: [fieldId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  harvestDate    DateTime
  fieldLocation  String?
  divisionSize   Decimal?      @db.Decimal(10,2)
  expectedYield  Decimal?      @db.Decimal(10,2)
  actualYield    Decimal       @db.Decimal(10,2)
  yieldUnit      String        @default("kg")
  qualityGrade   String?
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, harvestDate])
  @@index([cropId])
  @@index([rotationPlanId])
  @@index([fieldId])
  @@map("harvest_records")
}

model FarmEvent {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation("UserFarmEvents", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title       String
  eventType   String
  date        DateTime
  cropId      Int?
  fieldId     Int?
  notes       String?   @db.Text
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, date])
  @@index([userId, eventType])
  @@map("farm_events")
}

model Equipment {
  id                Int                      @id @default(autoincrement())
  userId            String
  user              User                     @relation("UserEquipment", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name              String
  equipmentType     String
  purchaseDate      DateTime?
  hoursUsed         Decimal?                 @db.Decimal(10,2)
  nextServiceDueAt  DateTime?
  notes             String?                  @db.Text
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  maintenanceLogs   EquipmentMaintenanceLog[] @relation("EquipmentLogs")

  @@index([userId])
  @@map("equipment")
}

model EquipmentMaintenanceLog {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation("UserMaintenanceLogs", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  equipmentId Int
  equipment   Equipment @relation("EquipmentLogs", fields: [equipmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  logDate     DateTime
  description String
  cost        Decimal?  @db.Decimal(12,2)
  hoursAtService Decimal? @db.Decimal(10,2)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([equipmentId])
  @@map("equipment_maintenance_logs")
}

model IrrigationEvent {
  id           Int       @id @default(autoincrement())
  userId       String
  user         User      @relation("UserIrrigationEvents", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fieldId      Int?
  eventDate    DateTime
  durationMin  Int?
  volumeM3     Decimal?  @db.Decimal(10,3)
  method       String
  waterSource  String?
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, eventDate])
  @@map("irrigation_events")
}

model InventoryItem {
  id               Int                    @id @default(autoincrement())
  userId           String
  user             User                   @relation("UserInventoryItems", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name             String
  category         String
  quantity         Decimal                @db.Decimal(12,3)
  unit             String
  reorderThreshold Decimal?               @db.Decimal(12,3)
  costPerUnit      Decimal?               @db.Decimal(12,2)
  supplier         String?
  notes            String?                @db.Text
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  transactions     InventoryTransaction[] @relation("ItemTransactions")

  @@index([userId])
  @@index([userId, category])
  @@map("inventory_items")
}

model InventoryTransaction {
  id          Int           @id @default(autoincrement())
  userId      String
  user        User          @relation("UserInventoryTransactions", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  itemId      Int
  item        InventoryItem @relation("ItemTransactions", fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type        String
  quantity    Decimal       @db.Decimal(12,3)
  notes       String?       @db.Text
  transDate   DateTime      @default(now())
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([itemId])
  @@map("inventory_transactions")
}

model FinancialRecord {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation("UserFinancialRecords", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cropId      Int?
  crop        Crop?     @relation("CropFinancialRecords", fields: [cropId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type        String
  category    String
  amount      Decimal   @db.Decimal(12,2)
  currency    String    @default("EUR")
  recordDate  DateTime
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, recordDate])
  @@index([userId, type])
  @@index([cropId])
  @@map("financial_records")
}
