# ── Database ─────────────────────────────────────────────────────────────────
# Azure SQL Server connection string (Prisma sqlserver provider)
DATABASE_URL="sqlserver://<host>:1433;database=<db>;user=<user>;password=<pass>;encrypt=true;trustServerCertificate=false;loginTimeout=30"

# ── Auth0 ─────────────────────────────────────────────────────────────────────
AUTH0_SECRET="<long-random-secret-min-32-chars>"   # openssl rand -hex 32
AUTH0_BASE_URL="https://<your-domain>"             # e.g. https://farmapp.example.com
AUTH0_ISSUER_BASE_URL="https://<tenant>.auth0.com"
AUTH0_CLIENT_ID="<auth0-app-client-id>"
AUTH0_CLIENT_SECRET="<auth0-app-client-secret>"

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV="production"
# Email of the user who should have ADMIN role (used for the admin dashboard)
ADMIN_EMAIL="admin@example.com"
# Public URL used in links (no trailing slash)
NEXT_PUBLIC_API_URL="https://<your-domain>"

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
# Optional: override the model for each AI feature (defaults to gpt-4o-mini)
OPENAI_PEST_DIAGNOSIS_MODEL="gpt-4o-mini"
OPENAI_ROTATION_INSIGHT_MODEL="gpt-4o-mini"
OPENAI_FERTILIZATION_INSIGHT_MODEL="gpt-4o-mini"
OPENAI_CROP_LOOKUP_MODEL="gpt-4o-mini"

# ── Weather ───────────────────────────────────────────────────────────────────
OPENWEATHERMAP_API_KEY="<openweathermap-key>"

# ── Stripe (billing / premium tier) ──────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PREMIUM_PRICE_ID="price_..."

# ── Email notifications (SMTP) ────────────────────────────────────────────────
# All four vars must be set for email sending to be active.
SMTP_HOST="smtp.example.com"
SMTP_USER="notifications@example.com"
SMTP_PASS="<smtp-password>"
SMTP_PORT="465"                      # 465 = SSL, 587 = STARTTLS
FROM_EMAIL="noreply@example.com"     # Defaults to SMTP_USER if omitted

# ── Cron / scheduled jobs ─────────────────────────────────────────────────────
# Secret appended as ?secret=... when calling /api/Controllers/Notifications
# Set this in your cron scheduler (Vercel Cron, GitHub Actions, etc.)
CRON_SECRET="<long-random-secret>"   # openssl rand -hex 32
